# voe-client environment — all real .env* files are gitignored and
# machine-specific. Vite loads them BY MODE; this file documents which file
# feeds which command. Only VITE_-prefixed variables reach the app code.
#
#   command                    mode         reads (in addition to .env/.env.local)
#   ─────────────────────────  ───────────  ─────────────────────────────────────
#   npm run dev                development  .env.development
#   npm run build              production   .env.production
#   npm run dev:https          https        .env.https / .env.https.local
#   npm run build:https        https        .env.https / .env.https.local
#   npm run build:devpreview   devpreview   .env.devpreview
#
# .env.local is loaded in EVERY mode — shared values live there.

# ─── Variables ───────────────────────────────────────────────────────────────
# Where the API (voe-server) is reached — baked into the bundle AT BUILD TIME.
# Scheme must match the page: an https build needs an https API URL.
#   .env.development:   http://localhost:3001
#   .env.production:    http://<server-ip>:<http-api-port>
#   .env.https.local:   https://<server-ip>:<https-api-port>
VITE_API_URL=http://localhost:3001

# "development" shows the test-environment badge; anything else hides it
VITE_APP_ENV=development

# Shared upload limits (keep in .env.local, mirrored with the server)
VITE_MAX_UPLOAD_FILES=5
VITE_MAX_UPLOAD_SIZE_MB=10

# Shows the EU funding header/footer on the home page when "true"
VITE_SHOW_EU_FUNDING=false

# ─── Not Vite: scripts/serve-client.mjs (production static server) ──────────
# Plain process env vars for the zero-dependency server that hosts the copied
# builds: HTTP_PORT (3000), HTTPS_PREVIEW_PORT (5443), HTTP_DIR (dist),
# HTTPS_DIR (dist-https), HTTPS_CERT_PATH / HTTPS_KEY_PATH (certs/*.pem).
